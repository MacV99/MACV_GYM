<footer class="flex-column">
  <div class="footer-brand flex-row">
    <img src="/favicon.svg" alt="" aria-hidden="true" class="brand-icon" />
    <h3>MACV GYM</h3>
  </div>

  <p class="footer-tagline">Registra. Progresa. Supérate.</p>

  <code>©2026 Miguel Cuellar</code>
</footer>

<style>
  footer {
    background-color: var(--clr-dark);
    background-image: radial-gradient(
      circle,
      rgba(255, 255, 255, 0.08) 1px,
      transparent 1px
    );
    background-size: 22px 22px;
    margin-top: auto;
    color: var(--clr-white);
    padding-bottom: 20px;
  }

  .footer-brand {
    justify-content: flex-start;
    gap: 10px;
  }

  .footer-brand .brand-icon {
    height: 1.6rem;
    width: auto;
  }

  h3 {
    color: var(--clr-white);
    font-size: 1.3rem;
    letter-spacing: 4px;
  }

  .footer-tagline {
    color: rgba(255, 255, 255, 0.4);
    font-size: 0.8rem;
    letter-spacing: 1px;
  }

  code {
    color: rgba(255, 255, 255, 0.3);
    font-size: 0.72rem;
  }
</style>
