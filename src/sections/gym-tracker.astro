---
import { ASSET_BY_KEY, ASSET_BY_NAME } from "../data/exercise-map.js";
import { CATALOG } from "../data/exercise-catalog.js";
import {
  UI,
  GROUP_LABELS,
  GROUP_MUSCLES,
  EQUIPO_META,
  EQUIPOS,
} from "../data/i18n.js";

const API_URL =
  "https://script.google.com/macros/s/AKfycbwAzgf3dkXJLt0Yhh9l93sBkL1GVhwZ8jekaj6kVT8D_m2QLNXvw3UNc-aCGuJR135KCA/exec";
---

<section id="tracker">
  <div class="tracker-header flex-column">
    <p class="tracker-eyebrow flex-row">
      <img src="/favicon.svg" alt="" aria-hidden="true" class="brand-icon" />
      <span id="eyebrow-count">—</span>
    </p>
    <h2 data-i18n="heading">My Routine</h2>
    <p class="tracker-sub" data-i18n="sub">Current weights &amp; sets</p>
  </div>

  <div class="select-wrap">
    <select
      id="grupo-select"
      class="select-native"
      aria-hidden="true"
      tabindex="-1"
      disabled
    >
      <option>—</option>
    </select>
    <button
      type="button"
      id="grupo-trigger"
      class="select-trigger"
      aria-haspopup="listbox"
      aria-expanded="false"
      aria-label="Select muscle group"
      data-i18n-aria="select_group_aria"
      disabled
    >
      <span id="grupo-trigger-label">—</span>
      <i class="bi bi-chevron-down"></i>
    </button>
    <div
      id="grupo-list"
      class="select-list"
      role="listbox"
      aria-label="Grupo muscular"
    ></div>
  </div>

  <div id="panels" class="flex-column"></div>
</section>

<div id="gym-pills" class="flex-column" aria-live="polite" aria-atomic="false"></div>

<div id="modal-create" class="modal-overlay flex-row" hidden>
  <div
    class="modal-box flex-column"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-title"
    tabindex="-1"
  >
    <div class="modal-head flex-row">
      <h3 id="modal-title" data-i18n="modal_title">New exercise</h3>
      <button class="btn-modal-close" aria-label="Close" data-i18n-aria="close_aria"
        ><i class="bi bi-x-lg"></i></button
      >
    </div>

    <form id="form-create-modal" class="flex-column">
      <input type="hidden" name="nombre" value="" />
      <input type="hidden" name="equipo" value="" />
      <input type="hidden" name="slug" value="" />

      {/* ── STEP 1: catalog picker ── */}
      <div id="cat-picker" class="cat-picker flex-column">
        <div class="cat-search-row flex-row">
          <i class="bi bi-search"></i>
          <input
            type="text"
            id="cat-search"
            class="cat-search"
            placeholder="Search exercise…"
            autocomplete="off"
            spellcheck="false"
          />
        </div>
        <div id="cat-muscles" class="cat-muscles flex-row"></div>
        <div id="cat-results" class="cat-results"></div>
      </div>

      {/* ── STEP 2: selected exercise + details ── */}
      <div id="cat-detail" class="cat-detail flex-column" hidden>
        <div class="cat-selected flex-row">
          <div class="cat-selected-fig" id="cat-selected-fig">
            <img id="cat-selected-img" class="card-figure-img" alt="" width="512" height="512" />
          </div>
          <div class="cat-selected-meta flex-column">
            <span id="cat-selected-name" class="cat-selected-name"></span>
            <span id="cat-selected-equip" class="badge"></span>
          </div>
          <button type="button" id="cat-change" class="btn-cancel-create">
            <span data-i18n="change_exercise">Change</span>
          </button>
        </div>

        <div class="edit-fields flex-row">
          <label class="edit-field flex-column edit-field--full" id="field-grupo">
            <span data-i18n="field_group">Muscle group</span>
            <div class="combo-field" data-type="grupo">
              <input
                type="text"
                class="combo-input"
                placeholder="Select or create group…"
                autocomplete="off"
                spellcheck="false"
              />
              <input type="hidden" name="grupo_id" data-combo-hidden value="" />
            </div>
          </label>
          <label class="edit-field flex-column">
            <span data-i18n="field_sets">Sets</span>
            <input type="number" name="series" value="3" min="1" max="20" />
          </label>
          <label class="edit-field flex-column">
            <span data-i18n="field_reps">Reps</span>
            <input type="number" name="reps" value="10" min="1" max="100" />
          </label>
          <label class="edit-field flex-column">
            <span data-i18n="field_weight">Weight</span>
            <input type="text" name="peso" placeholder="—" />
          </label>
        </div>
      </div>

      <div class="edit-actions flex-row" style="margin-top:8px">
        <button type="button" class="btn-cancel-create btn-modal-close">
          <span data-i18n="btn_cancel">Cancel</span>
        </button>
        <button type="submit" class="btn-save" id="btn-submit-modal" disabled>
          <span data-i18n="btn_create">Create</span>
        </button>
      </div>
    </form>
  </div>
</div>

<style is:global>
  /* ── BASE ── */
  #tracker {
    background-color: var(--clr-dark);
    background-image: var(--dot-grid);
    background-size: var(--dot-grid-size);
    padding: 36px 16px 70px;
    gap: 22px;
  }

  /* ── SECTION HEADER ── */
  .tracker-header {
    justify-content: flex-start;
    gap: 5px;
    text-align: center;
  }

  .tracker-eyebrow {
    justify-content: flex-start;
    gap: 6px;
    color: var(--clr-dark2);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .tracker-eyebrow .brand-icon {
    height: 0.95rem;
    width: auto;
  }

  .tracker-header h2 {
    color: var(--clr-white);
    font-size: 2rem;
    letter-spacing: -0.02em;
  }

  .tracker-sub {
    color: var(--clr-dark2);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* ── SELECT (custom dropdown, monocromo) ── */
  .select-wrap {
    position: relative;
    width: 100%;
    max-width: 320px;
  }

  /* nativo = fuente de verdad, oculto visualmente */
  .select-native {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
  }

  .select-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    background: var(--bg-subtle);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-md);
    color: var(--clr-white);
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 13px 16px;
    cursor: pointer;
    transition: var(--transition);
  }

  .select-trigger .bi {
    color: var(--clr-white);
    opacity: 0.6;
    font-size: 0.8rem;
    transition: transform 0.2s ease;
  }

  .select-trigger[aria-expanded='true'] .bi {
    transform: rotate(180deg);
  }

  .select-trigger:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .select-trigger:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .select-list {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    right: 0;
    z-index: 60;
    display: none;
    flex-direction: column;
    gap: 3px;
    background: var(--surface-3);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    padding: 6px;
    max-height: 300px;
    overflow-y: auto;
  }

  .select-list.open {
    display: flex;
    animation: fadeInUp 0.12s ease;
  }

  .select-opt {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    text-align: left;
    background: none;
    border: none;
    border-radius: var(--radius-sm);
    color: var(--clr-white);
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 11px 14px;
    transition: background 0.12s ease;
  }

  .select-opt[aria-selected='true'] {
    background: var(--bg-subtle);
  }

  .select-opt[aria-selected='true']::after {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--clr-white);
    flex-shrink: 0;
  }

  @media (hover: hover) {
    .select-trigger:hover:not(:disabled) {
      background: rgba(var(--rgb-white), 0.07);
      border-color: var(--border-hover);
    }

    .select-opt:hover {
      background: rgba(var(--rgb-white), 0.08);
    }
  }

  /* ── PANELS ── */
  #panels {
    align-items: stretch;
    justify-content: flex-start;
    gap: 8px;
    width: 100%;
    max-width: 900px;
  }

  .tracker-loading {
    color: rgba(255, 255, 255, 0.3);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 2px;
    text-align: center;
    text-transform: uppercase;
    padding: 40px 0;
  }

  .muscle-panel {
    display: none;
    width: 100%;
  }

  .muscle-panel.active {
    display: block;
    animation: fadeIn 0.18s ease;
  }

  /* ── EXERCISE GRID — mobile: 1 col ── */
  .exercise-grid {
    align-items: stretch;
    justify-content: flex-start;
    gap: 8px;
  }

  /* ── EXERCISE CARD ── */
  .exercise-card {
    background: var(--bg-subtle);
    border: solid 1px var(--border-soft);
    border-radius: var(--radius-lg);
    padding: 18px;
    align-items: stretch;
    justify-content: flex-start;
    min-height: 130px;
    transition: var(--transition);
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
  }

  /* form de edición: re-habilitar selección/edición de texto */
  .card-edit-form input {
    -webkit-user-select: text;
    user-select: text;
    -webkit-touch-callout: default;
  }

  .exercise-card.editing {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .card-top {
    align-items: stretch;
    justify-content: flex-start;
    min-width: 0;
  }

  .card-top-row {
    justify-content: space-between;
    gap: 6px;
  }

  .card-top h4 {
    color: var(--clr-white);
    font-family: var(--font-display);
    font-size: 1.25rem;
    letter-spacing: -0.015em;
    line-height: 1.15;
    font-weight: 600;
  }

  .card-grupo {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--clr-dark2);
  }

  /* ── EXERCISE FIGURE (ilustración del ejercicio) ── */
  .card-figure {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 10px 0 14px;
    overflow: hidden;
  }

  .card-figure-img {
    height: 100px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    /* assets ya vienen en trazo blanco sobre transparente → sin invertir */
    opacity: 0.92;
    transition: var(--transition);
  }

  /* tap: durante el ciclo de frames solo subimos opacidad, sin escalar
     (el scale se veía como "rebote" y tapaba el cambio de pose) */
  .card-figure.figure-playing .card-figure-img {
    opacity: 1;
    transform: none;
    transition: none;
  }

  @media (hover: hover) {
    .exercise-card:not(.editing):hover .card-figure-img {
      opacity: 1;
      transform: scale(1.04);
    }
  }

  @media (min-width: 750px) {
    .card-figure-img {
      height: 104px;
    }
  }

  /* ── BADGE EQUIPO (mono: la distinción la lleva el texto, no el color) ── */
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 9px;
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--clr-dark2);
    background: var(--bg-subtle);
    border: 1px solid var(--border-soft);
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* ── METRICS FOOTER (stats balanceados en 3 columnas iguales) ── */
  .card-metrics {
    justify-content: space-between;
    gap: 0;
    flex-wrap: nowrap;
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--border-soft);
  }

  .metric {
    position: relative;
    align-items: center;
    justify-content: center;
    gap: 5px;
    flex: 1;
    min-width: 0;
    text-align: center;
  }

  /* divisor vertical sutil entre columnas */
  .metric + .metric::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 1px;
    height: 24px;
    background: var(--border-soft);
  }

  .metric-val {
    color: var(--clr-white);
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    white-space: nowrap;
  }

  .metric-lbl {
    color: var(--clr-dark2);
    font-family: var(--font-mono);
    font-size: 0.56rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  .metric-sep {
    color: rgba(255, 255, 255, 0.18);
    font-size: 0.7rem;
    font-weight: 300;
    line-height: 1;
    padding-bottom: 12px;
  }

  /* ── CONTEXT MENU ── */
  .card-context-menu {
    background: var(--surface-2);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 12px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.6);
    align-items: stretch;
    justify-content: flex-start;
    gap: 2px;
    overflow: hidden;
    padding: 5px;
    position: fixed;
    z-index: 9999;
    animation: fadeInUp 0.1s ease;
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
  }

  .ctx-btn {
    justify-content: flex-start;
    background: none;
    border: none;
    border-radius: 8px;
    color: var(--clr-white);
    cursor: pointer;
    font-family: inherit;
    font-size: 0.78rem;
    font-weight: 700;
    gap: 8px;
    letter-spacing: 1px;
    padding: 9px 14px;
    transition: var(--transition);
    white-space: nowrap;
  }

  .ctx-delete {
    color: var(--clr-danger);
  }

  .exercise-card.long-pressing {
    background: rgba(255, 255, 255, 0.1);
  }

  /* ── DRAG HANDLE / REORDER ── */
  .card-top-right {
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  .drag-handle {
    display: none;
    align-items: center;
    justify-content: center;
    padding: 2px 0;
    background: none;
    border: none;
    color: var(--clr-accent);
    opacity: 0.45;
    cursor: grab;
    touch-action: none;
    transition: var(--transition);
  }

  .drag-handle .bi {
    font-size: 18px;
  }

  #panels.mode-single .drag-handle {
    display: inline-flex;
  }

  .exercise-card.dragging {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(var(--rgb-accent), 0.45);
    box-shadow: var(--shadow-lg);
    cursor: grabbing;
    position: relative;
    z-index: 10;
    transition: none;
    will-change: transform;
  }

  .exercise-card.dragging .drag-handle {
    opacity: 1;
    cursor: grabbing;
  }

  @media (hover: hover) {
    .drag-handle:hover {
      opacity: 1;
    }
  }

  /* ── EDIT FORM ── */
  .card-edit-form {
    display: none;
    flex-direction: column;
    gap: 10px;
    width: 100%;
  }

  .card-edit-form:not([hidden]) {
    display: flex;
  }

  .edit-fields {
    align-items: stretch;
    justify-content: flex-start;
    flex-wrap: wrap;
    gap: 8px;
  }

  .edit-field {
    align-items: stretch;
    justify-content: flex-start;
    gap: 4px;
    flex: 1;
    min-width: 60px;
  }

  .edit-field--full {
    flex: 0 0 100%;
  }

  .edit-field span {
    color: var(--clr-dark2);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-align: center;
    text-transform: uppercase;
  }

  .edit-field input,
  .edit-field select {
    appearance: none;
    background: rgba(var(--rgb-white), 0.06);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-sm);
    color: var(--clr-white);
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 600;
    padding: 11px 10px;
    text-align: center;
    transition: var(--transition);
    width: 100%;
  }

  .edit-field input::placeholder {
    color: rgba(var(--rgb-white), 0.3);
  }

  .edit-field select option {
    background: var(--clr-dark);
    text-align: left;
  }

  .edit-field input:focus,
  .edit-field select:focus {
    border-color: rgba(var(--rgb-white), 0.4);
    box-shadow: var(--focus-ring);
    outline: none;
  }

  /* ── COMBO FIELD ── */
  .combo-field {
    width: 100%;
  }

  .combo-input {
    text-align: center;
  }

  /* ── COMBO PORTAL (appended to body, position:fixed) ── */
  .combo-portal {
    background: var(--surface-3);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 10px;
    overflow: hidden;
    position: fixed;
    z-index: 9999;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
  }

  .combo-opt {
    color: var(--clr-white);
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 0.82rem;
    font-weight: 600;
    padding: 9px 14px;
    text-align: left;
    transition: background 0.12s ease;
  }

  .combo-opt-create {
    color: var(--clr-accent);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    font-style: italic;
  }

  @media (hover: hover) {
    .combo-opt:hover {
      background: rgba(255, 255, 255, 0.1);
    }
  }

  /* ── CREATE SECTION ── */
  .create-section {
    margin-top: 8px;
  }

  .btn-create-toggle {
    background: rgba(255, 255, 255, 0.03);
    border: 1px dashed rgba(255, 255, 255, 0.14);
    border-radius: 14px;
    color: rgba(255, 255, 255, 0.35);
    cursor: pointer;
    font-family: inherit;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 2px;
    padding: 12px;
    text-transform: uppercase;
    transition: var(--transition);
    width: 100%;
  }

  .create-form {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 14px;
    display: none;
    flex-direction: column;
    gap: 10px;
    margin-top: 6px;
    padding: 16px;
  }

  .create-form:not([hidden]) {
    display: flex;
  }

  .edit-actions {
    align-items: stretch;
    justify-content: flex-start;
    gap: 6px;
  }

  .btn-save {
    background: var(--clr-accent);
    border: none;
    border-radius: 8px;
    color: var(--clr-dark);
    cursor: pointer;
    flex: 1;
    font-family: inherit;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    padding: 9px;
    text-transform: uppercase;
    transition: var(--transition);
  }

  .btn-save:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .btn-cancel,
  .btn-cancel-create {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    color: rgba(255, 255, 255, 0.45);
    cursor: pointer;
    font-family: inherit;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    padding: 9px 14px;
    text-transform: uppercase;
    transition: var(--transition);
  }

  @media (hover: hover) {
    .exercise-card:not(.editing):hover {
      background: rgba(var(--rgb-white), 0.07);
      border-color: var(--border-hover);
    }

    .ctx-btn:hover {
      background: rgba(var(--rgb-white), 0.08);
    }

    .ctx-delete:hover {
      background: rgba(var(--rgb-white), 0.08);
    }

    .edit-field input:hover,
    .edit-field select:hover {
      border-color: rgba(255, 255, 255, 0.3);
    }

    .btn-save:not(:disabled):hover {
      opacity: 0.82;
    }

    .btn-cancel:hover,
    .btn-cancel-create:hover {
      background: rgba(255, 255, 255, 0.11);
      color: var(--clr-white);
    }

    .btn-create-toggle:hover {
      background: rgba(255, 255, 255, 0.07);
      border-color: rgba(255, 255, 255, 0.25);
      color: var(--clr-white);
    }
  }

  /* ── MODAL ── */
  .modal-overlay {
    align-items: flex-start;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    bottom: 0;
    justify-content: center;
    left: 0;
    padding: 24px 16px 16px;
    position: fixed;
