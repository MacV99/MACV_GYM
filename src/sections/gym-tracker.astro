---
const API_URL =
  "https://script.google.com/macros/s/AKfycbwAzgf3dkXJLt0Yhh9l93sBkL1GVhwZ8jekaj6kVT8D_m2QLNXvw3UNc-aCGuJR135KCA/exec";
---

<section id="tracker">
  <div class="tracker-header flex-column">
    <p class="tracker-eyebrow flex-row">
      <img src="/favicon.svg" alt="" aria-hidden="true" class="brand-icon" />
      <span id="eyebrow-count">— grupos · — ejercicios</span>
    </p>
    <h2>Mi Rutina</h2>
    <p class="tracker-sub">Pesos y series actuales</p>
  </div>

  <div class="select-wrap">
    <select id="grupo-select" aria-label="Seleccionar grupo muscular" disabled>
      <option>Cargando...</option>
    </select>
    <i class="bi bi-chevron-down"></i>
  </div>

  <div id="panels" class="flex-column"></div>
</section>

<div id="gym-pills" class="flex-column" aria-live="polite" aria-atomic="false"></div>

<div id="modal-create" class="modal-overlay flex-row" hidden>
  <div
    class="modal-box flex-column"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-title"
    tabindex="-1"
  >
    <div class="modal-head flex-row">
      <h3 id="modal-title">Nuevo ejercicio</h3>
      <button class="btn-modal-close" aria-label="Cerrar"
        ><i class="bi bi-x-lg"></i></button
      >
    </div>
    <form id="form-create-modal">
      <div class="edit-fields flex-row">
        <label class="edit-field flex-column edit-field--full">
          <span>Nombre</span>
          <input type="text" name="nombre" placeholder="Ej: Press banca" required />
        </label>
        <label class="edit-field flex-column edit-field--full">
          <span>Grupo muscular</span>
          <div class="combo-field" data-type="grupo">
            <input type="text" class="combo-input" placeholder="Seleccionar o crear grupo..." autocomplete="off" spellcheck="false" />
            <input type="hidden" name="grupo_id" data-combo-hidden value="" />
          </div>
        </label>
        <label class="edit-field flex-column edit-field--full">
          <span>Equipo</span>
          <div class="combo-field" data-type="equipo">
            <input type="text" class="combo-input" value="barra" autocomplete="off" spellcheck="false" />
            <input type="hidden" name="equipo" data-combo-hidden value="barra" />
          </div>
        </label>
        <label class="edit-field flex-column">
          <span>Series</span>
          <input type="number" name="series" value="3" min="1" max="20" />
        </label>
        <label class="edit-field flex-column">
          <span>Reps</span>
          <input type="number" name="reps" value="10" min="1" max="100" />
        </label>
        <label class="edit-field flex-column">
          <span>Peso</span>
          <input type="text" name="peso" placeholder="—" />
        </label>
      </div>
      <div class="edit-actions flex-row" style="margin-top:8px">
        <button type="submit" class="btn-save">Crear</button>
        <button type="button" class="btn-cancel-create btn-modal-close">Cancelar</button>
      </div>
    </form>
  </div>
</div>

<style is:global>
  /* ── BASE ── */
  #tracker {
    background-color: var(--clr-dark);
    background-image: var(--dot-grid);
    background-size: var(--dot-grid-size);
    padding: 36px 16px 70px;
    gap: 22px;
  }

  /* ── SECTION HEADER ── */
  .tracker-header {
    justify-content: flex-start;
    gap: 5px;
    text-align: center;
  }

  .tracker-eyebrow {
    justify-content: flex-start;
    gap: 6px;
    color: var(--clr-accent);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
  }

  .tracker-eyebrow .brand-icon {
    height: 0.95rem;
    width: auto;
  }

  .tracker-header h2 {
    color: var(--clr-white);
    font-size: 1.7rem;
    letter-spacing: 4px;
  }

  .tracker-sub {
    color: rgba(255, 255, 255, 0.38);
    font-size: 0.72rem;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  /* ── SELECT ── */
  .select-wrap {
    position: relative;
    width: 100%;
    max-width: 320px;
  }

  .select-wrap select {
    width: 100%;
    appearance: none;
    -webkit-appearance: none;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 14px;
    color: var(--clr-white);
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 14px 44px 14px 18px;
    cursor: pointer;
    transition: var(--transition);
  }

  .select-wrap select:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .select-wrap select option {
    background: var(--clr-dark);
    color: var(--clr-white);
    letter-spacing: 1px;
  }

  .select-wrap .bi {
    position: absolute;
    right: 16px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--clr-accent);
    font-size: 0.9rem;
    pointer-events: none;
  }

  @media (hover: hover) {
    .select-wrap select:hover:not(:disabled) {
      background: rgba(255, 255, 255, 0.11);
      border-color: rgba(255, 255, 255, 0.24);
    }
  }

  /* ── PANELS ── */
  #panels {
    align-items: stretch;
    justify-content: flex-start;
    gap: 8px;
    width: 100%;
    max-width: 900px;
  }

  .tracker-loading {
    color: rgba(255, 255, 255, 0.3);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 2px;
    text-align: center;
    text-transform: uppercase;
    padding: 40px 0;
  }

  .muscle-panel {
    display: none;
    width: 100%;
  }

  .muscle-panel.active {
    display: block;
    animation: fadeInUp 0.22s ease;
  }

  /* ── EXERCISE GRID — mobile: 1 col ── */
  .exercise-grid {
    align-items: stretch;
    justify-content: flex-start;
    gap: 8px;
  }

  /* ── EXERCISE CARD ── */
  .exercise-card {
    background: rgba(255, 255, 255, 0.05);
    border: solid 1px rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 16px;
    align-items: stretch;
    justify-content: flex-start;
    min-height: 130px;
    transition: var(--transition);
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
  }

  /* form de edición: re-habilitar selección/edición de texto */
  .card-edit-form input {
    -webkit-user-select: text;
    user-select: text;
    -webkit-touch-callout: default;
  }

  .exercise-card.editing {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .card-top {
    align-items: stretch;
    justify-content: flex-start;
    min-width: 0;
  }

  .card-top-row {
    justify-content: space-between;
    gap: 6px;
  }

  .card-top h4 {
    color: var(--clr-white);
    font-size: 0.88rem;
    letter-spacing: 1.5px;
    line-height: 1.3;
    font-weight: 700;
  }

  .card-grupo {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--clr-accent);
    opacity: 0.75;
  }

  /* ── BADGES ── */
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: 2px 7px;
    border-radius: 5px;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .badge .bi {
    font-size: 9px;
  }

  .badge-barra {
    background: color-mix(in oklch, var(--badge-barra) 18%, transparent);
    color: var(--badge-barra);
    border: 1px solid color-mix(in oklch, var(--badge-barra) 30%, transparent);
  }

  .badge-mancuerna {
    background: color-mix(in oklch, var(--badge-mancuerna) 18%, transparent);
    color: var(--badge-mancuerna);
    border: 1px solid
      color-mix(in oklch, var(--badge-mancuerna) 30%, transparent);
  }

  .badge-maquina {
    background: color-mix(in oklch, var(--badge-maquina) 18%, transparent);
    color: var(--badge-maquina);
    border: 1px solid color-mix(in oklch, var(--badge-maquina) 30%, transparent);
  }

  .badge-disco {
    background: color-mix(in oklch, var(--badge-disco) 18%, transparent);
    color: var(--badge-disco);
    border: 1px solid color-mix(in oklch, var(--badge-disco) 30%, transparent);
  }

  .badge-corporal {
    background: color-mix(in oklch, var(--badge-corporal) 18%, transparent);
    color: var(--badge-corporal);
    border: 1px solid
      color-mix(in oklch, var(--badge-corporal) 30%, transparent);
  }

  /* ── METRICS ROW ── */
  .card-metrics {
    gap: 50px;
    flex-wrap: nowrap;
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .metric {
    justify-content: flex-start;
    gap: 2px;
  }

  .metric-val {
    color: var(--clr-white);
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
  }

  .metric-lbl {
    color: rgba(255, 255, 255, 0.32);
    font-size: 0.55rem;
    text-transform: uppercase;
    letter-spacing: 0.8px;
  }

  .metric-sep {
    color: rgba(255, 255, 255, 0.18);
    font-size: 0.7rem;
    font-weight: 300;
    line-height: 1;
    padding-bottom: 12px;
  }

  /* ── CONTEXT MENU ── */
  .card-context-menu {
    background: #1e1e1e;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 12px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.6);
    align-items: stretch;
    justify-content: flex-start;
    gap: 2px;
    overflow: hidden;
    padding: 5px;
    position: fixed;
    z-index: 9999;
    animation: fadeInUp 0.1s ease;
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
  }

  .ctx-btn {
    justify-content: flex-start;
    background: none;
    border: none;
    border-radius: 8px;
    color: var(--clr-white);
    cursor: pointer;
    font-family: inherit;
    font-size: 0.78rem;
    font-weight: 700;
    gap: 8px;
    letter-spacing: 1px;
    padding: 9px 14px;
    transition: var(--transition);
    white-space: nowrap;
  }

  .ctx-delete {
    color: #ff6b6b;
  }

  .exercise-card.long-pressing {
    background: rgba(255, 255, 255, 0.1);
    transform: scale(0.98);
  }

  /* ── DRAG HANDLE / REORDER ── */
  .card-top-right {
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  .drag-handle {
    display: none;
    align-items: center;
    justify-content: center;
    padding: 2px 0;
    background: none;
    border: none;
    color: var(--clr-accent);
    opacity: 0.45;
    cursor: grab;
    touch-action: none;
    transition: var(--transition);
  }

  .drag-handle .bi {
    font-size: 18px;
  }

  #panels.mode-single .drag-handle {
    display: inline-flex;
  }

  .exercise-card.dragging {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(var(--rgb-accent), 0.45);
    box-shadow: var(--shadow-lg);
    cursor: grabbing;
    position: relative;
    z-index: 10;
    transition: none;
    will-change: transform;
  }

  .exercise-card.dragging .drag-handle {
    opacity: 1;
    cursor: grabbing;
  }

  @media (hover: hover) {
    .drag-handle:hover {
      opacity: 1;
    }
  }

  /* ── EDIT FORM ── */
  .card-edit-form {
    display: none;
    flex-direction: column;
    gap: 10px;
    width: 100%;
  }

  .card-edit-form:not([hidden]) {
    display: flex;
  }

  .edit-fields {
    align-items: stretch;
    justify-content: flex-start;
    flex-wrap: wrap;
    gap: 8px;
  }

  .edit-field {
    align-items: stretch;
    justify-content: flex-start;
    gap: 4px;
    flex: 1;
    min-width: 60px;
  }

  .edit-field--full {
    flex: 0 0 100%;
  }

  .edit-field span {
    color: rgba(255, 255, 255, 0.38);
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-align: center;
    text-transform: uppercase;
  }

  .edit-field input,
  .edit-field select {
    appearance: none;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    color: var(--clr-white);
    font-family: inherit;
    font-size: 0.9rem;
    font-weight: 700;
    padding: 8px 6px;
    text-align: center;
    transition: var(--transition);
    width: 100%;
  }

  .edit-field select option {
    background: var(--clr-dark);
    text-align: left;
  }

  .edit-field input:focus,
  .edit-field select:focus {
    border-color: var(--clr-accent);
    outline: none;
  }

  /* ── COMBO FIELD ── */
  .combo-field {
    width: 100%;
  }

  .combo-input {
    text-align: center;
  }

  /* ── COMBO PORTAL (appended to body, position:fixed) ── */
  .combo-portal {
    background: #242424;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 10px;
    overflow: hidden;
    position: fixed;
    z-index: 9999;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
  }

  .combo-opt {
    color: var(--clr-white);
    cursor: pointer;
    font-family: "Montserrat", sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    padding: 9px 14px;
    text-align: left;
    transition: background 0.12s ease;
  }

  .combo-opt-create {
    color: var(--clr-accent);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    font-style: italic;
  }

  @media (hover: hover) {
    .combo-opt:hover {
      background: rgba(255, 255, 255, 0.1);
    }
  }

  /* ── CREATE SECTION ── */
  .create-section {
    margin-top: 8px;
  }

  .btn-create-toggle {
    background: rgba(255, 255, 255, 0.03);
    border: 1px dashed rgba(255, 255, 255, 0.14);
    border-radius: 14px;
    color: rgba(255, 255, 255, 0.35);
    cursor: pointer;
    font-family: inherit;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 2px;
    padding: 12px;
    text-transform: uppercase;
    transition: var(--transition);
    width: 100%;
  }

  .create-form {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 14px;
    display: none;
    flex-direction: column;
    gap: 10px;
    margin-top: 6px;
    padding: 16px;
  }

  .create-form:not([hidden]) {
    display: flex;
  }

  .edit-actions {
    align-items: stretch;
    justify-content: flex-start;
    gap: 6px;
  }

  .btn-save {
    background: var(--clr-accent);
    border: none;
    border-radius: 8px;
    color: var(--clr-dark);
    cursor: pointer;
    flex: 1;
    font-family: inherit;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    padding: 9px;
    text-transform: uppercase;
    transition: var(--transition);
  }

  .btn-save:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .btn-cancel,
  .btn-cancel-create {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    color: rgba(255, 255, 255, 0.45);
    cursor: pointer;
    font-family: inherit;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    padding: 9px 14px;
    text-transform: uppercase;
    transition: var(--transition);
  }

  @media (hover: hover) {
    .exercise-card:not(.editing):hover {
      background: rgba(255, 255, 255, 0.09);
      border-color: rgba(255, 255, 255, 0.16);
    }

    .ctx-btn:hover {
      background: rgba(255, 255, 255, 0.08);
    }

    .ctx-delete:hover {
      background: rgba(255, 107, 107, 0.12);
    }

    .edit-field input:hover,
    .edit-field select:hover {
      border-color: rgba(255, 255, 255, 0.3);
    }

    .btn-save:not(:disabled):hover {
      opacity: 0.82;
    }

    .btn-cancel:hover,
    .btn-cancel-create:hover {
      background: rgba(255, 255, 255, 0.11);
      color: var(--clr-white);
    }

    .btn-create-toggle:hover {
      background: rgba(255, 255, 255, 0.07);
      border-color: rgba(255, 255, 255, 0.25);
      color: var(--clr-white);
    }
  }

  /* ── MODAL ── */
  .modal-overlay {
    align-items: flex-start;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    bottom: 0;
    justify-content: center;
    left: 0;
    padding: 24px 16px 16px;
    position: fixed;
    right: 0;
    top: 0;
    z-index: 200;
  }

  .modal-overlay[hidden] {
    display: none;
  }

  .modal-box {
    background: color-mix(in oklch, var(--clr-dark) 96%, white);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 20px;
    align-items: stretch;
    justify-content: flex-start;
    gap: 18px;
    max-height: 85vh;
    max-width: 480px;
    overflow-y: auto;
    padding: 20px;
    width: 100%;
  }

  .modal-head {
    justify-content: space-between;
  }

  .modal-head h3 {
    color: var(--clr-white);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
  }

  .btn-modal-close {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    color: rgba(255, 255, 255, 0.5);
    cursor: pointer;
    font-size: 0.85rem;
    line-height: 1;
    padding: 6px 9px;
    transition: var(--transition);
  }

  @media (hover: hover) {
    .btn-modal-close:hover {
      background: rgba(255, 255, 255, 0.12);
      color: var(--clr-white);
    }
  }

  @media (min-width: 750px) {
    .modal-overlay {
      align-items: center;
      padding: 24px;
    }

    #tracker {
      padding: 60px 24px 80px;
      gap: 30px;
    }

    .tracker-header h2 {
      font-size: 2.4rem;
    }

    .exercise-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }

    .exercise-card {
      padding: 18px;
      min-height: 140px;
    }

    .card-top h4 {
      font-size: 0.82rem;
    }

    .metric-val {
      font-size: 1.1rem;
    }
  }

  /* ── PILLS ── */
  #gym-pills {
    bottom: 24px;
    align-items: stretch;
    justify-content: flex-start;
    gap: 8px;
    left: 50%;
    pointer-events: none;
    position: fixed;
    transform: translateX(-50%);
    z-index: 500;
  }

  .gym-pill {
    justify-content: flex-start;
    animation: pill-in 0.25s ease;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-radius: 100px;
    font-size: 0.78rem;
    font-weight: 600;
    gap: 7px;
    letter-spacing: 0.02em;
    padding: 9px 16px;
    white-space: nowrap;
  }

  .gym-pill-ok {
    background: rgba(97, 195, 255, 0.18);
    border: 1px solid rgba(97, 195, 255, 0.35);
    color: var(--clr-accent);
  }

  .gym-pill-err {
    background: rgba(255, 80, 80, 0.18);
    border: 1px solid rgba(255, 80, 80, 0.35);
    color: #ff6b6b;
  }

  .gym-pill-out {
    animation: pill-out 0.2s ease forwards;
  }

  @keyframes pill-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes pill-out {
    to {
      opacity: 0;
      transform: translateY(6px);
    }
  }
</style>

<script define:vars={{ API_URL }}>
  /* ── CONSTANTS ── */
  const EQUIPO_META = {
    barra: { label: "BAR", icon: "bi-dash-lg" },
    mancuerna: { label: "MAN", icon: "bi-plus-lg" },
    máquina: { label: "MAQ", icon: "bi-gear-fill" },
    disco: { label: "DISC", icon: "bi-record-circle-fill" },
    corporal: { label: "BODY", icon: "bi-person-fill" },
  };
  const EQUIPOS = ["barra", "mancuerna", "máquina", "disco", "corporal"];
  const CACHE_KEY = "macv_gym_v1";

  /* ── CACHE ── */
  let gymData = null;

  function readCache() {
    try {
      return JSON.parse(localStorage.getItem(CACHE_KEY));
    } catch {
      return null;
    }
  }

  function writeCache(grupos) {
    gymData = grupos;
    try {
      localStorage.setItem(CACHE_KEY, JSON.stringify(grupos));
    } catch {}
  }

  function updateCacheExercise(grupoId, oldNombre, patch) {
    if (!gymData) return;
    const g = gymData.find((g) => g.id === grupoId);
    const ej = g?.ejercicios.find((e) => e.nombre === oldNombre);
    if (ej) {
      Object.assign(ej, patch);
      writeCache(gymData);
    }
  }

  function addCacheExercise(grupoId, ej) {
    if (!gymData) return;
    const g = gymData.find((g) => g.id === grupoId);
    if (g) {
      g.ejercicios.push(ej);
      writeCache(gymData);
    }
  }

  function slug(equipo) {
    return equipo.replace("á", "a");
  }

  function slugify(str) {
    return (
      str
        .trim()
        .normalize("NFD")
        .replace(/[̀-ͯ]/g, "")
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/^-|-$/g, "") || "grupo-" + Date.now()
    );
  }

  /* ── COMBO PORTAL ── */
  let activePortal = null;

  function getComboOptions(type) {
    if (type === "equipo") return EQUIPOS.map((e) => ({ value: e, label: e }));
    if (type === "grupo")
      return (gymData || []).map((g) => ({ value: g.id, label: g.nombre }));
    return [];
  }

  function openComboPortal(input, showAll = false) {
    closeComboPortal();

    const combo = input.closest(".combo-field");
    const type = combo?.dataset.type;
    const options = getComboOptions(type);
    const q = showAll ? "" : input.value.trim().toLowerCase();
    const filtered = options.filter((o) => o.label.toLowerCase().includes(q));
    const exact = options.some(
      (o) => o.label.toLowerCase() === input.value.trim().toLowerCase(),
    );

    let html = filtered
      .map(
        (o) =>
          `<div class="combo-opt" data-value="${o.value}" data-label="${o.label}">${o.label}</div>`,
      )
      .join("");

    if (input.value.trim() && !exact) {
      const val =
        type === "grupo" ? slugify(input.value.trim()) : input.value.trim();
      html =
        `<div class="combo-opt combo-opt-create" data-value="${val}" data-label="${input.value.trim()}">+ Crear &ldquo;${input.value.trim()}&rdquo;</div>` +
        html;
    }

    if (!html) return;

    const rect = input.getBoundingClientRect();
    const portal = document.createElement("div");
    portal.className = "combo-portal";
    portal.style.top = rect.bottom + 4 + "px";
    portal.style.left = rect.left + "px";
    portal.style.width = rect.width + "px";
    portal.innerHTML = html;
    document.body.appendChild(portal);
    activePortal = { portal, input };

    portal.addEventListener("mousedown", (e) => {
      const opt = e.target.closest(".combo-opt");
      if (!opt) return;
      e.preventDefault();
      applyComboOption(input, opt.dataset.value, opt.dataset.label);
    });
  }

  function applyComboOption(input, value, label) {
    const combo = input.closest(".combo-field");
    const hidden = combo?.querySelector("[data-combo-hidden]");
    input.value = label;
    if (hidden) hidden.value = value;

    // If creating a new grupo, add panel + option to DOM
    if (
      combo?.dataset.type === "grupo" &&
      gymData &&
      !gymData.find((g) => g.id === value)
    ) {
      const newGrupo = { id: value, nombre: label, ejercicios: [] };
      gymData.push(newGrupo);
      writeCache(gymData);

      document.getElementById("panels")?.insertAdjacentHTML(
        "beforeend",
        `
        <div id="${value}" class="muscle-panel" role="tabpanel">
          <div class="exercise-grid flex-column"></div>
        </div>
      `,
      );

      const select = document.getElementById("grupo-select");
      select?.insertAdjacentHTML(
        "beforeend",
        `<option value="${value}">${label}</option>`,
      );

      const count = document.getElementById("eyebrow-count");
      const total = gymData.reduce((s, g) => s + g.ejercicios.length, 0);
      if (count)
        count.textContent = `${gymData.length} grupos · ${total} ejercicios`;
    }

    closeComboPortal();
  }

  function closeComboPortal() {
    if (activePortal) {
      activePortal.portal.remove();
      activePortal = null;
    }
  }

  // Focus → select all text + show all options
  document.addEventListener("focusin", (e) => {
    const input = e.target.closest(".combo-input");
    if (!input) return;
    input.select();
    openComboPortal(input, true);
  });

  // Typing → filter options (show "Crear X" if no match)
  document.addEventListener("input", (e) => {
    const input = e.target.closest(".combo-input");
    if (!input) return;
    const hidden = input
      .closest(".combo-field")
      ?.querySelector("[data-combo-hidden]");
    if (hidden) hidden.value = input.value.trim();
    openComboPortal(input, false);
  });

  // Click outside → close portal
  document.addEventListener("mousedown", (e) => {
    if (
      !e.target.closest(".combo-field") &&
      !e.target.closest(".combo-portal")
    ) {
      closeComboPortal();
    }
  });

  /* ── BUILD CARD ── */
  function buildComboField(type, value) {
    return `
      <div class="combo-field" data-type="${type}">
        <input type="text" class="combo-input" value="${value}" autocomplete="off" spellcheck="false">
        <input type="hidden" name="${type === "equipo" ? "equipo" : "grupo_id"}" data-combo-hidden value="${value}">
      </div>
    `;
  }

  function buildMetricsHtml(ej) {
    const pesoVal =
      ej.peso != null && ej.peso !== ""
        ? `${ej.peso}${ej.unidad ? " " + ej.unidad : ""}`
        : "—";
    return `
      <div class="metric flex-column">
        <span class="metric-val">${ej.series ?? "—"}</span>
        <span class="metric-lbl">series</span>
      </div>
      <div class="metric flex-column">
        <span class="metric-val">${ej.reps ?? "—"}</span>
        <span class="metric-lbl">reps</span>
      </div>
      <div class="metric flex-column">
        <span class="metric-val">${pesoVal}</span>
        <span class="metric-lbl">peso</span>
      </div>
    `;
  }

  function buildCard(grupoId, grupoNombre, ej) {
    const s = slug(ej.equipo);
    const meta = EQUIPO_META[ej.equipo] ?? {
      label: ej.equipo.toUpperCase(),
      icon: "bi-dot",
    };
    return `
      <article
        class="exercise-card flex-column equipo-${s}"
        data-grupo="${grupoId}"
        data-nombre="${ej.nombre}"
        data-unidad="${ej.unidad ?? ""}"
      >
        <div class="card-top flex-column">
          <div class="card-top-row flex-row">
            <span class="card-grupo">${grupoNombre}</span>
            <div class="card-top-right flex-row">
              <span class="badge badge-${s}">
                <i class="bi ${meta.icon}"></i>${meta.label}
              </span>
              <button type="button" class="drag-handle" aria-label="Reordenar" tabindex="-1">
                <i class="bi bi-grip-vertical"></i>
              </button>
            </div>
          </div>
          <h4>${ej.nombre}</h4>
        </div>
        <div class="card-metrics flex-row">${buildMetricsHtml(ej)}</div>
        <form class="card-edit-form" hidden>
          <div class="edit-fields flex-row">
            <label class="edit-field flex-column edit-field--full">
              <span>Nombre</span>
              <input type="text" name="nombre" value="${ej.nombre}" required>
            </label>
            <label class="edit-field flex-column edit-field--full">
              <span>Equipo</span>
              ${buildComboField("equipo", ej.equipo)}
            </label>
            <label class="edit-field flex-column">
              <span>Series</span>
              <input type="number" name="series" value="${ej.series}" min="1" max="20">
            </label>
            <label class="edit-field flex-column">
              <span>Reps</span>
              <input type="number" name="reps" value="${ej.reps}" min="1" max="100">
            </label>
            <label class="edit-field flex-column">
              <span>Peso</span>
              <input type="text" name="peso" value="${ej.peso ?? ""}">
            </label>
          </div>
          <div class="edit-actions flex-row">
            <button type="submit" class="btn-save">Guardar</button>
            <button type="button" class="btn-cancel">Cancelar</button>
          </div>
        </form>
      </article>
    `;
  }

  /* ── MODAL ── */
  const modal = document.getElementById("modal-create");

  function openModal() {
    if (!modal) return;
    modal.hidden = false;
    document.body.style.overflow = "hidden";
    modal.querySelector(".modal-box")?.focus();
  }

  function closeModal() {
    if (!modal) return;
    modal.hidden = true;
    document.body.style.overflow = "";
    document.getElementById("form-create-modal")?.reset();
    // Reset combo display inputs
    const grupoCombo = modal.querySelector(".combo-field[data-type=grupo]");
    if (grupoCombo) {
      grupoCombo.querySelector(".combo-input").value = "";
      grupoCombo.querySelector("[data-combo-hidden]").value = "";
    }
    const equipoCombo = modal.querySelector(".combo-field[data-type=equipo]");
    if (equipoCombo) {
      equipoCombo.querySelector(".combo-input").value = "barra";
      equipoCombo.querySelector("[data-combo-hidden]").value = "barra";
    }
    closeComboPortal();
  }

  modal?.addEventListener("click", (e) => {
    if (e.target === modal) closeModal();
  });
  modal
    ?.querySelectorAll(".btn-modal-close")
    .forEach((btn) => btn.addEventListener("click", closeModal));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      if (activePortal) closeComboPortal();
      else if (!modal?.hidden) closeModal();
    }
  });
  window.addEventListener("gym:open-create", openModal);

  /* ── EDIT CARD ── */
  function openEdit(card) {
    card.classList.add("editing");
    card.querySelector(".card-metrics").hidden = true;
    card.querySelector(".card-edit-form").hidden = false;
  }

  function closeEdit(card) {
    card.classList.remove("editing");
    card.querySelector(".card-metrics").hidden = false;
    card.querySelector(".card-edit-form").hidden = true;
    closeComboPortal();
  }

  /* ── PILLS ── */
  function showPill(msg, type = "ok") {
    const pill = document.createElement("div");
    pill.className = `gym-pill gym-pill-${type} flex-row`;
    pill.innerHTML = `<i class="bi ${type === "ok" ? "bi-check-circle-fill" : "bi-exclamation-circle-fill"}"></i>${msg}`;
    document.getElementById("gym-pills").appendChild(pill);
    setTimeout(() => {
      pill.classList.add("gym-pill-out");
      pill.addEventListener("animationend", () => pill.remove(), {
        once: true,
      });
    }, 2500);
  }

  /* ── API ── */
  async function postData(payload) {
    const res = await fetch(API_URL, {
      method: "POST",
      mode: "cors",
      redirect: "follow",
      headers: { "Content-Type": "text/plain" },
      body: JSON.stringify(payload),
    });
    const json = await res.json().catch(() => ({}));
    if (!res.ok || !json.ok)
      throw new Error(json.error || `HTTP ${res.status}`);
    return json;
  }

  function saveEdit(form) {
    const card = form.closest(".exercise-card");
    const payload = {
      action: "update",
      grupo_id: card.dataset.grupo,
      old_nombre: card.dataset.nombre,
      nombre: form.elements.nombre.value.trim(),
      equipo: form.elements.equipo.value,
      series: Number(form.elements.series.value),
      reps: Number(form.elements.reps.value),
      peso: form.elements.peso.value || null,
    };

    updateCacheExercise(payload.grupo_id, payload.old_nombre, {
      nombre: payload.nombre,
      equipo: payload.equipo,
      series: payload.series,
      reps: payload.reps,
      peso: payload.peso,
    });

    card.dataset.nombre = payload.nombre;
    const s = slug(payload.equipo);
    const meta = EQUIPO_META[payload.equipo] ?? {
      label: payload.equipo.toUpperCase(),
      icon: "bi-dot",
    };
    card.className = `exercise-card flex-column equipo-${s} editing`;
    card.querySelector(".card-top h4").textContent = payload.nombre;
    const badge = card.querySelector(".badge");
    badge.className = `badge badge-${s}`;
    badge.innerHTML = `<i class="bi ${meta.icon}"></i>${meta.label}`;
    card.querySelector(".card-metrics").innerHTML = buildMetricsHtml({
      series: payload.series,
      reps: payload.reps,
      peso: payload.peso,
      unidad: card.dataset.unidad,
    });
    closeEdit(card);

    postData(payload)
      .then(() => showPill("Ejercicio editado"))
      .catch(() => showPill("Error al guardar", "err"));
  }

  function createEjercicio(form) {
    const grupoId = form.elements.grupo_id.value;
    const grupoNombre =
      form.querySelector("[data-type='grupo'] .combo-input")?.value.trim() ||
      grupoId;
    const ej = {
      nombre: form.elements.nombre.value.trim(),
      equipo: form.elements.equipo.value,
      series: Number(form.elements.series.value),
      reps: Number(form.elements.reps.value),
      peso: form.elements.peso.value || null,
      unidad: null,
    };
    if (!ej.nombre || !grupoId) return;

    addCacheExercise(grupoId, ej);
    document
      .querySelector(`#${grupoId} .exercise-grid`)
      ?.insertAdjacentHTML("beforeend", buildCard(grupoId, grupoNombre, ej));
    closeModal();

    postData({
      action: "create",
      grupo_id: grupoId,
      grupo_nombre: grupoNombre,
      ...ej,
    })
      .then(() => showPill("Ejercicio creado"))
      .catch(() => showPill("Error al crear", "err"));
  }

  /* ── DATA ── */
  function fetchJSONP(url) {
    return new Promise((resolve, reject) => {
      const cb = "_gym_" + Date.now();
      const script = document.createElement("script");
      const timer = setTimeout(() => {
        cleanup();
        reject(new Error("timeout"));
      }, 10000);
      function cleanup() {
        clearTimeout(timer);
        delete window[cb];
        script.remove();
      }
      window[cb] = (data) => {
        cleanup();
        resolve(data);
      };
      script.onerror = () => {
        cleanup();
        reject(new Error("load failed"));
      };
      script.src = `${url}?callback=${cb}`;
      document.head.appendChild(script);
    });
  }

  function renderGrupos(grupos) {
    const panelsEl = document.getElementById("panels");
    const select = document.getElementById("grupo-select");

    const curVal = select.value;
    const validId = grupos.find((g) => g.id === curVal)?.id ?? null;
    const showAll = !validId;

    const total = grupos.reduce((s, g) => s + g.ejercicios.length, 0);
    document.getElementById("eyebrow-count").textContent =
      `${grupos.length} grupos · ${total} ejercicios`;

    select.disabled = false;
    select.innerHTML =
      `<option value="todos"${showAll ? " selected" : ""}>Todos</option>` +
      grupos
        .map(
          (g) =>
            `<option value="${g.id}"${g.id === validId ? " selected" : ""}>${g.nombre}</option>`,
        )
        .join("");

    // arrastre solo en vista de una categoría
    panelsEl.classList.toggle("mode-single", !showAll);

    panelsEl.innerHTML = grupos
      .map(
        (g) => `
      <div id="${g.id}" class="muscle-panel${showAll || g.id === validId ? " active" : ""}" role="tabpanel">
        <div class="exercise-grid flex-column">
          ${sortByOrden(g.ejercicios)
            .map((ej) => buildCard(g.id, g.nombre, ej))
            .join("")}
        </div>
      </div>
    `,
      )
      .join("");
  }

  function sortByOrden(ejercicios) {
    return ejercicios
      .map((ej, i) => ({ ej, i }))
      .sort((a, b) => (a.ej.orden ?? a.i) - (b.ej.orden ?? b.i))
      .map((x) => x.ej);
  }

  async function loadData() {
    const panelsEl = document.getElementById("panels");
    const select = document.getElementById("grupo-select");

    const cached = readCache();
    if (cached) {
      writeCache(cached);
      renderGrupos(cached);
    } else {
      panelsEl.innerHTML = '<p class="tracker-loading">Cargando...</p>';
      select.disabled = true;
    }

    const grupos = await fetchJSONP(API_URL);
    const changed = JSON.stringify(grupos) !== JSON.stringify(gymData);
    writeCache(grupos);
    if (!cached || changed) safeRender(grupos);
  }

  /* ── CONTEXT MENU PORTAL ── */
  let activeContextMenu = null;

  function showContextMenu(card, x, y) {
    // dedupe: si el timer de long-press y el contextmenu nativo disparan casi
    // a la vez (típico en el primer press tras recargar), el segundo llamado
    // borraría y recrearía el menú → titileo. Ignorar si ya hay uno abierto
    // para la misma card.
    if (activeContextMenu && activeContextMenu.card === card) return;
    closeContextMenu();
    const menu = document.createElement("div");
    menu.className = "card-context-menu flex-column";
    menu.innerHTML = `
      <button class="ctx-btn flex-row ctx-edit"><i class="bi bi-pencil-fill"></i>Editar</button>
      <button class="ctx-btn flex-row ctx-delete"><i class="bi bi-trash3-fill"></i>Eliminar</button>
    `;
    document.body.appendChild(menu);

    const mW = 160,
      mH = 88;
    let top = y + 10;
    let left = x - mW / 2;
    if (top + mH > window.innerHeight - 8) top = y - mH - 10;
    if (left < 8) left = 8;
    if (left + mW > window.innerWidth - 8) left = window.innerWidth - mW - 8;
    menu.style.top = top + "px";
    menu.style.left = left + "px";

    activeContextMenu = { menu, card };

    menu.querySelector(".ctx-edit").addEventListener("click", () => {
      openEdit(card);
      closeContextMenu();
    });
    menu.querySelector(".ctx-delete").addEventListener("click", () => {
      deleteEjercicio(card);
      closeContextMenu();
    });
  }

  function closeContextMenu() {
    if (activeContextMenu) {
      activeContextMenu.menu.remove();
      activeContextMenu = null;
    }
    setTimeout(flushPending, 0);
  }

  document.addEventListener("pointerdown", (e) => {
    if (activeContextMenu && !e.target.closest(".card-context-menu"))
      closeContextMenu();
  });

  /* ── PENDING RENDER (defer re-render while user is interacting) ── */
  let pendingGrupos = null;

  function safeRender(grupos) {
    if (lpCard || activeContextMenu) {
      pendingGrupos = grupos;
      return;
    }
    pendingGrupos = null;
    renderGrupos(grupos);
  }

  function flushPending() {
    if (!pendingGrupos || lpCard || activeContextMenu) return;
    const g = pendingGrupos;
    pendingGrupos = null;
    renderGrupos(g);
  }

  /* ── LONG PRESS ── */
  let lpTimer = null;
  let lpCard = null;
  let lpX = 0,
    lpY = 0;
  let skipNextContextMenu = false;

  function cancelLongPress() {
    if (!lpTimer) return;
    clearTimeout(lpTimer);
    lpTimer = null;
    if (lpCard) {
      lpCard.classList.remove("long-pressing");
      lpCard = null;
    }
    flushPending();
  }

  const panels = document.getElementById("panels");

  panels.addEventListener("pointerdown", (e) => {
    const card = e.target.closest(".exercise-card");
    if (!card || card.classList.contains("editing")) return;
    if (e.target.closest("button")) return;
    lpCard = card;
    lpX = e.clientX;
    lpY = e.clientY;
    lpTimer = setTimeout(() => {
      card.classList.remove("long-pressing");
      showContextMenu(card, lpX, lpY);
      skipNextContextMenu = true;
      lpCard = null;
      lpTimer = null;
    }, 500);
    card.classList.add("long-pressing");
  });

  panels.addEventListener("pointerup", cancelLongPress);
  panels.addEventListener("pointercancel", cancelLongPress);
  panels.addEventListener("pointermove", (e) => {
    if (!lpCard) return;
    const d = Math.hypot(e.clientX - lpX, e.clientY - lpY);
    if (d > 10) cancelLongPress();
  });

  panels.addEventListener("contextmenu", (e) => {
    const card = e.target.closest(".exercise-card");
    if (card && !card.classList.contains("editing")) {
      e.preventDefault();
      if (skipNextContextMenu) {
        skipNextContextMenu = false;
        return;
      }
      showContextMenu(card, e.clientX, e.clientY);
    }
  });

  /* ── DRAG REORDER (solo vista de una categoría) ── */
  const FLIP_MS = 160;
  // % de la OTRA card que el borde delantero debe cruzar para reordenar.
  // 0.5 = mitad (menor = más sensible, mayor = hay que solapar más)
  const SWAP_RATIO = 0.5;
  let dragCard = null;
  let dragGrid = null;
  let dragGrupo = null;
  let dragPointerId = null;
  let grabY = 0; // ancla del puntero, se ajusta al reordenar
  let lastY = 0; // última Y del puntero, para saber la dirección

  // distancia (px) que sigue al dedo, sin la transición base de la card
  function followPointer(clientY) {
    dragCard.style.transform = `translateY(${clientY - grabY}px) scale(1.02)`;
  }

  // top real de layout ignorando cualquier transform (propio o de FLIP en curso)
  function untransformedTop(el) {
    const t = getComputedStyle(el).transform;
    let ty = 0;
    if (t && t !== "none") ty = new DOMMatrixReadOnly(t).m42;
    return el.getBoundingClientRect().top - ty;
  }

  // anima a las hermanas deslizándose a su nueva posición (técnica FLIP)
  function flipSiblings(mutate) {
    const cards = [...dragGrid.querySelectorAll(".exercise-card")];
    const first = new Map(cards.map((c) => [c, c.getBoundingClientRect().top]));
    mutate();
    for (const c of cards) {
      if (c === dragCard) continue;
      const dy = first.get(c) - c.getBoundingClientRect().top;
      if (!dy) continue;
      c.style.transition = "none";
      c.style.transform = `translateY(${dy}px)`;
      requestAnimationFrame(() => {
        c.style.transition = `transform ${FLIP_MS}ms ease`;
        c.style.transform = "";
      });
    }
  }

  panels.addEventListener("pointerdown", (e) => {
    const handle = e.target.closest(".drag-handle");
    if (!handle) return;
    if (!panels.classList.contains("mode-single")) return;
    e.preventDefault();
    cancelLongPress();
    dragCard = handle.closest(".exercise-card");
    dragGrid = dragCard.closest(".exercise-grid");
    dragGrupo = dragCard.dataset.grupo;
    dragPointerId = e.pointerId;
    grabY = e.clientY;
    lastY = e.clientY;
    handle.setPointerCapture(e.pointerId);
    dragCard.classList.add("dragging");
    followPointer(e.clientY);
  });

  panels.addEventListener("pointermove", (e) => {
    if (!dragCard || e.pointerId !== dragPointerId) return;

    const siblings = [
      ...dragGrid.querySelectorAll(".exercise-card:not(.dragging)"),
    ];
    // Referencia = borde DELANTERO de la card arrastrada según dirección:
    // bajando → borde inferior, subiendo → borde superior. Así el cálculo es
    // independiente del dedo (que está arriba) y simétrico arriba/abajo.
    // Dispara al cruzar SWAP_RATIO de la altura de la otra card (0.5 = mitad).
    const goingDown = e.clientY >= lastY;
    lastY = e.clientY;
    const dragRect = dragCard.getBoundingClientRect();
    const ref = goingDown ? dragRect.bottom : dragRect.top;
    const target =
      siblings.find((s) => {
        const mid = untransformedTop(s) + s.offsetHeight * SWAP_RATIO;
        return ref < mid;
      }) ?? null;

    const needsMove =
      (target && dragCard.nextElementSibling !== target) ||
      (!target && dragCard !== dragGrid.lastElementChild);

    if (needsMove) {
      const before = untransformedTop(dragCard);
      flipSiblings(() => {
        if (target) dragGrid.insertBefore(dragCard, target);
        else dragGrid.appendChild(dragCard);
      });
      // el slot de la card cambió: reanclar para que siga bajo el dedo
      grabY += untransformedTop(dragCard) - before;
    }

    followPointer(e.clientY);
  });

  function endDrag(e) {
    if (!dragCard || (e && e.pointerId !== dragPointerId)) return;
    const card = dragCard;
    const grid = dragGrid;
    const grupoId = dragGrupo;
    dragCard = dragGrid = dragGrupo = null;
    dragPointerId = null;

    // asentar la card en su slot con una breve transición
    card.style.transition = `transform ${FLIP_MS}ms ease`;
    card.style.transform = "translateY(0) scale(1)";
    setTimeout(() => {
      card.classList.remove("dragging");
      card.style.transition = "";
      card.style.transform = "";
    }, FLIP_MS);

    const orden = [...grid.querySelectorAll(".exercise-card")].map(
      (c) => c.dataset.nombre,
    );
    reorderCache(grupoId, orden);
    postData({ action: "reorder", grupo_id: grupoId, orden })
      .then(() => showPill("Orden guardado"))
      .catch(() => showPill("Error al ordenar", "err"));
  }

  panels.addEventListener("pointerup", endDrag);
  panels.addEventListener("pointercancel", endDrag);

  /* ── DELETE ── */
  function deleteCacheExercise(grupoId, nombre) {
    if (!gymData) return;
    const g = gymData.find((g) => g.id === grupoId);
    if (g) {
      g.ejercicios = g.ejercicios.filter((e) => e.nombre !== nombre);
      writeCache(gymData);
    }
  }

  function reorderCache(grupoId, nombresEnOrden) {
    if (!gymData) return;
    const g = gymData.find((g) => g.id === grupoId);
    if (!g) return;
    g.ejercicios.sort(
      (a, b) =>
        nombresEnOrden.indexOf(a.nombre) - nombresEnOrden.indexOf(b.nombre),
    );
    g.ejercicios.forEach((ej, i) => (ej.orden = i));
    writeCache(gymData);
  }

  function deleteEjercicio(card) {
    const grupoId = card.dataset.grupo;
    const nombre = card.dataset.nombre;

    deleteCacheExercise(grupoId, nombre);
    card.remove();
    const count = document.getElementById("eyebrow-count");
    const total = gymData.reduce((s, g) => s + g.ejercicios.length, 0);
    if (count)
      count.textContent = `${gymData.length} grupos · ${total} ejercicios`;

    postData({ action: "delete", grupo_id: grupoId, nombre })
      .then(() => showPill("Ejercicio eliminado"))
      .catch(() => showPill("Error al eliminar", "err"));
  }

  /* ── EVENT DELEGATION ── */
  panels.addEventListener("click", (e) => {
    if (e.target.closest(".btn-cancel"))
      closeEdit(e.target.closest(".exercise-card"));
  });

  panels.addEventListener("submit", (e) => {
    e.preventDefault();
    if (e.target.matches(".card-edit-form")) saveEdit(e.target);
  });

  document
    .getElementById("form-create-modal")
    ?.addEventListener("submit", (e) => {
      e.preventDefault();
      createEjercicio(e.target);
    });

  document.getElementById("grupo-select").addEventListener("change", (e) => {
    const val = e.target.value;
    document
      .getElementById("panels")
      .classList.toggle("mode-single", val !== "todos");
    document.querySelectorAll(".muscle-panel").forEach((p) => {
      p.classList.toggle("active", val === "todos" || p.id === val);
    });
  });

  loadData().catch(console.error);
</script>
