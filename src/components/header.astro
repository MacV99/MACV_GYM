---
---

<header class="flex-row">
  <a href="/" class="brand flex-row" aria-label="Home" data-i18n-aria="brand_home_aria">
    <img src="/favicon.svg" alt="" aria-hidden="true" class="brand-icon" />
    <span>MACV GYM</span>
  </a>
  <div class="header-actions flex-row">
    <button
      type="button"
      class="btn-lang"
      data-lang-toggle
      aria-label="Switch language"
      data-i18n-aria="lang_toggle_aria"
    >
      <i class="bi bi-translate"></i>
      <span data-lang-current>EN</span>
    </button>
    <button id="btn-open-create" class="btn-new-ex" aria-label="New exercise" data-i18n-aria="new_ex_aria">
      <i class="bi bi-plus-lg"></i>
    </button>
  </div>
</header>

<style>
  header {
    align-items: center;
    justify-content: space-between;
    position: sticky;
    top: 10px;
    background: var(--header-bg);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    width: 95%;
    height: 70px;
    margin: 10px auto;
    padding: 12px 16px;
    transition: var(--transition);
    z-index: 100;
  }

  .brand {
    justify-content: flex-start;
    gap: 8px;
    margin-right: auto;
    color: var(--clr-white);
    font-weight: 800;
    font-size: 1rem;
    letter-spacing: 3px;
    text-transform: uppercase;
  }

  .brand .brand-icon {
    height: 1.4rem;
    width: auto;
  }

  .header-actions {
    align-items: center;
    gap: 8px;
  }

  .btn-new-ex {
    background: rgba(var(--rgb-accent), 0.12);
    border: 1px solid rgba(var(--rgb-accent), 0.3);
    border-radius: 10px;
    color: var(--clr-accent);
    cursor: pointer;
    font-size: 1.1rem;
    font-weight: 700;
    height: 36px;
    line-height: 1;
    padding: 0 12px;
    transition: var(--transition);
  }

  .btn-lang {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    color: rgba(255, 255, 255, 0.7);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    height: 36px;
    line-height: 1;
    padding: 0 12px;
    transition: var(--transition);
  }

  .btn-lang .bi {
    font-size: 0.9rem;
  }

  @media (hover: hover) {
    header:hover {
      background: rgba(255, 255, 255, 0.11);
      border-color: rgba(255, 255, 255, 0.16);
    }

    .btn-new-ex:hover {
      background: rgba(var(--rgb-accent), 0.22);
      border-color: rgba(var(--rgb-accent), 0.5);
    }

    .btn-lang:hover {
      background: rgba(255, 255, 255, 0.1);
      border-color: rgba(255, 255, 255, 0.24);
      color: var(--clr-white);
    }
  }

  @media (min-width: 750px) {
    header {
      width: 98%;
    }
  }
</style>

<script>
  document.getElementById("btn-open-create")?.addEventListener("click", () => {
    window.dispatchEvent(new CustomEvent("gym:open-create"));
  });
</script>
