---
---

<header class="flex-row">
  <a href="/" class="brand flex-row" aria-label="Inicio">
    <img src="/favicon.svg" alt="" aria-hidden="true" class="brand-icon" />
    <span>MACV GYM</span>
  </a>
  <button id="btn-open-create" class="btn-new-ex" aria-label="Nuevo ejercicio">
    <i class="bi bi-plus-lg"></i>
  </button>
</header>

<style>
  header {
    align-items: center;
    justify-content: space-between;
    position: sticky;
    top: 10px;
    background: var(--header-bg);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    width: 95%;
    height: 70px;
    margin: 10px auto;
    padding: 12px 16px;
    transition: var(--transition);
    z-index: 100;
  }

  .brand {
    justify-content: flex-start;
    gap: 8px;
    margin-right: auto;
    color: var(--clr-white);
    font-weight: 800;
    font-size: 1rem;
    letter-spacing: 3px;
    text-transform: uppercase;
  }

  .brand .brand-icon {
    height: 1.4rem;
    width: auto;
  }

  .btn-new-ex {
    background: rgba(var(--rgb-accent), 0.12);
    border: 1px solid rgba(var(--rgb-accent), 0.3);
    border-radius: 10px;
    color: var(--clr-accent);
    cursor: pointer;
    font-size: 1.1rem;
    font-weight: 700;
    height: 36px;
    line-height: 1;
    padding: 0 12px;
    transition: var(--transition);
  }

  @media (hover: hover) {
    header:hover {
      background: rgba(255, 255, 255, 0.11);
      border-color: rgba(255, 255, 255, 0.16);
    }

    .btn-new-ex:hover {
      background: rgba(var(--rgb-accent), 0.22);
      border-color: rgba(var(--rgb-accent), 0.5);
    }
  }

  @media (min-width: 750px) {
    header {
      width: 98%;
    }
  }
</style>

<script>
  document.getElementById("btn-open-create")?.addEventListener("click", () => {
    window.dispatchEvent(new CustomEvent("gym:open-create"));
  });
</script>
