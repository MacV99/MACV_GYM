<nav class="flex-column" aria-label="Menú principal">
  <i class="bi bi-list open-nav" aria-label="Abrir menú"></i>

  <div class="flex-column" id="overlay">
    <a href="/">Rutina</a>
    <a href="#tracker">Pesos</a>
    <i class="bi bi-x-lg close-nav" aria-label="Cerrar menú"></i>
  </div>
</nav>

<style>
  .open-nav {
    font-size: 28px;
    cursor: pointer;
  }

  #overlay {
    display: none;
    position: fixed;
    inset: 0;
    gap: 7%;
    background-color: var(--clr-dark);
    background-image: var(--dot-grid);
    background-size: var(--dot-grid-size);
    z-index: 100;
  }

  #overlay.new-nav {
    display: flex;
  }

  .close-nav {
    position: absolute;
    top: 0;
    right: 0;
    margin: 28px;
    font-size: 24px;
    cursor: pointer;
    border-radius: 10px;
    padding: 7px;
    color: var(--clr-white);
    border: solid 1px rgba(255, 255, 255, 0.2);
    background-color: rgba(255, 255, 255, 0.08);
  }

  #overlay a {
    font-size: 18px;
    background-color: rgba(255, 255, 255, 0.06);
    padding: 10px 17px;
    border: solid 1px rgba(255, 255, 255, 0.12);
    border-radius: 14px;
    letter-spacing: 7px;
    width: 210px;
    text-align: center;
    text-transform: uppercase;
    color: var(--clr-white);
  }

  @media (min-width: 750px) {
    .open-nav,
    .close-nav {
      display: none;
    }

    #overlay {
      display: flex;
      position: relative;
      inset: auto;
      flex-direction: row;
      width: auto;
      height: auto;
      gap: 7px;
      backdrop-filter: none;
      background: transparent;
    }

    #overlay a {
      font-size: 14px;
      letter-spacing: 0;
      width: auto;
      color: rgba(255, 255, 255, 0.7);
      transition: var(--transition);
    }
  }

  .open-nav {
    color: var(--clr-white);
  }

  @media (hover: hover) {
    #overlay a:hover {
      background-color: rgba(255, 255, 255, 0.1);
      color: var(--clr-white);
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const overlay = document.getElementById("overlay");
    const openBtn = document.querySelector(".open-nav");
    const closeBtn = document.querySelector(".close-nav");

    const open = () => {
      if (overlay) {
        overlay.classList.add("new-nav");
        document.body.style.overflow = "hidden";
      }
    };

    const close = () => {
      overlay?.classList.remove("new-nav");
      document.body.style.overflow = "auto";
    };

    openBtn?.addEventListener("click", open);
    closeBtn?.addEventListener("click", close);

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") close();
    });
  });
</script>
